# 复制为 .env.local 后填写。不要把 .env.local 提交到仓库。
# 项目中心：只在本地服务端读取。
OSG_GITHUB_TOKEN=
OSG_GITEE_TOKEN=
OSG_GITLAB_TOKEN=

# 可选：官方 OAuth 登录。每个平台在自己的开发者设置中创建 OAuth App。
OSG_GITHUB_CLIENT_ID=
OSG_GITHUB_CLIENT_SECRET=
OSG_GITEE_CLIENT_ID=
OSG_GITEE_CLIENT_SECRET=
OSG_GITLAB_CLIENT_ID=
OSG_GITLAB_CLIENT_SECRET=

# 可选：使用 TypeSafe 对项目按兴趣进行结构化评分。
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 可选：使用 OpenAI-compatible 模型辅助 Issue 分析。
OSG_MODEL_BASE_URL=
OSG_MODEL_NAME=
OSG_MODEL_API_KEY=

# 可选：发布到 ModelScope。
OSG_MODELSCOPE_TOKEN=

# 本机项目发现：额外的搜索目录（Windows 用 ; 分隔，macOS/Linux 用 :）
OSG_PROJECT_ROOTS=

# 评委/演示模式：开启后允许体验者直接使用你预置的模型额度（强制只读）。
OSG_DEMO_MODE=
OSG_DEMO_LABEL=
